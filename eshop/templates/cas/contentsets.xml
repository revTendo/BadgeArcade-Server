{% extends 'header.xml' %}{% block main %}<ListContentSetsExResponse xmlns="urn:cas.wsapi.broadon.com"><Version>2.0</Version><DeviceId>{{ id }}</DeviceId><MessageId>{{ message }}</MessageId><TimeStamp>{{ time }}</TimeStamp><ErrorCode>0</ErrorCode><ListResultTotalSize>{{ total }}</ListResultTotalSize>{% for entry in contents %}<Contents><TitleId>{{ entry.title_id }}</TitleId><Contents><TitleIncluded>true</TitleIncluded>{% for index in entry.content_indexes %}<ContentIndex>{{ index }}</ContentIndex>{% endfor %}</Contents>{% for attr in entry.attributes %}<Attributes><Name>{{ attr.name }}</Name><Value>{{ attr.value }}</Value></Attributes>{% endfor %}{% if include_prices %}<Prices><ItemId>{{ entry.item_id }}</ItemId><Price><Amount>{{ entry.price }}</Amount><Currency>{{ entry.currency }}</Currency></Price><Limits><Limits>0</Limits><LimitKind>PR</LimitKind></Limits><LicenseKind>PERMANENT</LicenseKind></Prices>{% endif %}</Contents>{% endfor %}</ListContentSetsExResponse>{% endblock %}
